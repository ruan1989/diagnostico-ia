# ---------------------------------------------------------------------------
# InvestAI — copie para .env e ajuste. NUNCA versione o .env preenchido.
# ---------------------------------------------------------------------------

# Token exigido no cabeçalho X-API-Token pelos endpoints que mudam algo.
# Se ficar vazio, um token aleatorio e gerado no boot e impresso no log.
INVESTAI_API_TOKEN=

# paper = simula tudo (padrao) | live = envia ordens reais.
# Trocar isto NAO e suficiente: o motor tambem precisa ser armado no painel.
INVESTAI_MODE=paper

# Capital de referencia para dimensionar posicao em modo simulado.
# Em modo real, o saldo da propria conta e usado.
INVESTAI_CAPITAL_USD=1000

# Gestao de risco. Os padroes sao conservadores de proposito.
INVESTAI_RISK_PER_TRADE_PCT=0.5
INVESTAI_MAX_DAILY_LOSS_PCT=2.0
INVESTAI_MAX_DRAWDOWN_PCT=10.0
INVESTAI_MAX_LEVERAGE=5
INVESTAI_MAX_POSITIONS=3

# Score minimo de confluencia para um sinal virar ordem (0-100).
INVESTAI_MIN_SCORE=66

# Intervalo entre varreduras completas do mercado, em segundos.
INVESTAI_SCAN_INTERVAL=300

# Universo analisado (vazio = lista padrao de 20 pares).
INVESTAI_UNIVERSE=

# 1 = usa gerador sintetico em vez da Bitget. Util para conhecer o sistema
# sem chave de API e sem acesso a rede. NAO use para decidir nada.
INVESTAI_SYNTHETIC=0

INVESTAI_DATA_DIR=data

# ---------------------------------------------------------------------------
# Chave de API da Bitget (alternativa ao keystore cifrado do painel).
#
# Crie em Bitget > API Management com permissao de LEITURA e TRADE em futuros.
# Deixe SAQUE e TRANSFERENCIA DESABILITADOS.
# A senha da sua conta Bitget nao e usada por este sistema em nenhum ponto.
# ---------------------------------------------------------------------------
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=

# Token opcional da brapi.dev, para atualizar precos de FII.
BRAPI_TOKEN=
