# ── AI Core ─────────────────────────────────────────────
# Provedor de LLM: mock | anthropic | openai
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ── API ─────────────────────────────────────────────────
API_PORT=4000
JWT_SECRET=change-me-in-production
# Segredo para verificar assinaturas de webhook de pagamento (HMAC)
WEBHOOK_SECRET=change-me-too

# ── Billing global (mock por padrão) ────────────────────
BILLING_PROVIDER=mock
# Moeda-base dos preços dos planos (Starter começa em 250 desta moeda)
BASE_CURRENCY=BRL
# Moeda em que VOCÊ (dono do sistema) quer receber: BRL, USD, EUR, BTC, USDT...
MERCHANT_PAYOUT_CURRENCY=BRL
# Provedores reais (produção)
STRIPE_SECRET_KEY=
MERCADOPAGO_TOKEN=
# Endereços de recebimento cripto (mock aceita qualquer valor)
CRYPTO_WALLET_BTC=
CRYPTO_WALLET_ETH=
CRYPTO_WALLET_USDT=

# ── Persistência (opcional; padrão = in-memory) ─────────
# DATABASE_URL=postgresql://user:pass@localhost:5432/aicos
