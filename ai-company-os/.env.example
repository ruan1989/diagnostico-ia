# ── AI Core ─────────────────────────────────────────────
# Provedor de LLM: mock | anthropic | openai
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ── API ─────────────────────────────────────────────────
API_PORT=4000
JWT_SECRET=change-me-in-production

# ── Billing (mock por padrão) ───────────────────────────
BILLING_PROVIDER=mock
STRIPE_SECRET_KEY=
MERCADOPAGO_TOKEN=
# Endereço de recebimento cripto (mock aceita qualquer valor)
CRYPTO_WALLET_BTC=
CRYPTO_WALLET_ETH=

# ── Persistência (opcional; padrão = in-memory) ─────────
# DATABASE_URL=postgresql://user:pass@localhost:5432/aicos
